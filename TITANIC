```{r}
library(tidyverse)
library(caret)
library(randomForest)

# Load the data
Titanic <- read.csv("Titanic-Dataset.csv")

# Data Cleaning
Titanic$Age[is.na(Titanic$Age)] <- median(Titanic$Age, na.rm = TRUE)
Titanic$Embarked[is.na(Titanic$Embarked)] <- 'S'
Titanic$Pclass <- as.factor(Titanic$Pclass)
Titanic$Sex <- as.factor(Titanic$Sex)
Titanic$Embarked <- as.factor(Titanic$Embarked)
Titanic$Survived <- as.factor(Titanic$Survived)  # Ensure 'Survived' is a factor

# Feature Engineering
Titanic$FamilySize <- Titanic$SibSp + Titanic$Parch + 1

# Splitting the Data
set.seed(123)
TitanicIndex <- createDataPartition(Titanic$Survived, p = 0.8, list = FALSE)
TitanicData <- Titanic[TitanicIndex, ]
testData <- Titanic[-TitanicIndex, ]

# Build the Model (Classification)
model <- randomForest(Survived ~ Pclass + Sex + Age + FamilySize + Fare + Embarked, data = TitanicData, ntree = 100)

# Make Predictions
predictions <- predict(model, testData)

# Evaluate the Model
confusionMatrix(predictions, testData$Survived)

```
